[global]
  width = 400
  height = 300
  origin = top-right
  offset = 16x16
  progress_bar = true
  progress_bar_height = 18
  progress_bar_frame_width = 0
  progress_bar_min_width = 150
  progress_bar_max_width = 350
  progress_bar_corner_radius = 14
  padding = 16
  horizontal_padding = 16
  text_icon_padding = 16
  frame_width = 0
  gap_size = 12
  font = CaskaydiaCove NFM 12
  line_height = 1.5
  format = "<b>%s</b>\n%b"
  stack_duplicates = true
  hide_duplicate_count = true
  show_indicators = false
  enable_recursive_icon_lookup = true
  icon_theme = "Adwaita"
  min_icon_size = 32
  max_icon_size = 96
  icon_corner_radius = 10
  title = Dunst
  class = Dunst
  corner_radius = 12

[urgency_low]
  background = "#1D2326"
  foreground = "#E6E7E6"
  timeout = 10

[urgency_normal]
  background = "#1D2326"
  foreground = "#E6E7E6"
  timeout = 10

[urgency_critical]
  background = "#1D2326"
  foreground = "#E6E7E6"
  timeout = 0
